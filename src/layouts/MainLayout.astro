---
import Footer from "../components/Footer";
import NavBar from "../components/NavBar";
import "../global_styles/variables.css";
const { showRegularFooter = true } = Astro.props;
const url = Astro.url;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.ico" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Lawrence's Blog</title>
	</head>
	<body>
		<div
			class=`page-body ${showRegularFooter && "page-height-with-footer"}`
		>
			<NavBar {url} />
			<main>
				<slot />
			</main>
			{showRegularFooter && <Footer />}
		</div>
	</body>
	<style>
		body {
			margin: 0;
			background: url("/images/oldschool.jpg");
			background-size: cover;
		}

		.page-body {
			height: 100%;
			display: flex;
			flex-direction: column;
			margin: auto;
			background-color: var(--background-paper);
			box-shadow: 0px 5px 5px var(--deep-blue);
		}

		.page-height-with-footer {
			height: 100vh;
		}

		@media (width <= 768px) {
			.page-body {
				/* WARN:This is hardcoded min-height for mobile */
				min-height: 180rem;
				width: 768px;
			}
		}

		@media (width >= 1200px) {
			.page-body {
				width: 1200px;
			}
		}
	</style>
</html>
